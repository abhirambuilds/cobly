# ============================================================================
# Cobly Docker stack — environment template.
# Copy to `.env` (which is gitignored) and adjust:  cp .env.docker.example .env
# NEVER commit your real .env. The values below are safe, non-secret placeholders.
# ============================================================================

# ---- Secret (REQUIRED) -----------------------------------------------------
# Must be at least 32 characters. The value below is a PLACEHOLDER for local use
# only — generate a real random secret before deploying anywhere real, e.g.:
#   openssl rand -hex 32
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars

# Token lifetime (optional; defaults to 1h if unset).
JWT_EXPIRES_IN=1h

# ---- MongoDB ---------------------------------------------------------------
# Default points at the in-stack MongoDB container over the internal Docker
# network (no credentials — it is not exposed to the host). To use a managed
# database (e.g. MongoDB Atlas) instead, put its full connection string here;
# it will stay in your local .env and never be committed.
MONGODB_URI=mongodb://mongo:27017/cobly

# ---- URLs / CORS -----------------------------------------------------------
# Origin the browser loads the frontend from. Must match FRONTEND_PORT below.
# The backend uses this to lock CORS in production.
FRONTEND_URL=http://localhost:8080

# BUILD-TIME URL the BROWSER uses to reach the backend API. Because the browser
# runs OUTSIDE the Docker network, this must be a host URL (localhost + the
# published backend port) and include the "/api" path prefix. Do NOT use
# http://backend:5000 here — that name only resolves inside the Docker network.
VITE_API_URL=http://localhost:5000/api

# ---- Host port mappings (optional) -----------------------------------------
# Change these if the default ports are already in use on your machine.
# If you change them, update FRONTEND_URL / VITE_API_URL to match.
BACKEND_PORT=5000
FRONTEND_PORT=8080
